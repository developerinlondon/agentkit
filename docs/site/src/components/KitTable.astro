---
import facts from "../generated/kit-facts.json";
---

<div class="ak-table">
	<table>
		<thead>
			<tr>
				<th>Kit</th>
				<th>Skills</th>
				<th>Selection</th>
				<th>What it covers</th>
			</tr>
		</thead>
		<tbody>
			{
				facts.kits.map((kit) => (
					<tr>
						<td>
							<code>{kit.id}</code>
						</td>
						<td>{facts.skills.filter((skill) => skill.kit === kit.id).length}</td>
						<td>
							{
								kit.id === "core"
									? "always installed"
									: kit.explicit
									? "explicit opt-in only"
									: "offered by default"
							}
						</td>
						<td>{kit.description}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.ak-table {
		overflow-x: auto;
	}
	td code {
		white-space: nowrap;
	}
</style>
