---
import current from "../generated/kit-facts.json";
import { factsFor, frozenByVersion } from "../lib/version-facts";

const frozen = frozenByVersion(
	import.meta.glob("../generated/frozen-facts/*.json", { eager: true }),
);
const { facts } = factsFor(Astro.url.pathname, current, frozen);
---

<div class="ak-table">
	<table>
		<thead>
			<tr>
				<th>Unit</th>
				<th>Event</th>
				<th>Matcher</th>
				<th>Timeout</th>
				<th>Fail-closed budget</th>
			</tr>
		</thead>
		<tbody>
			{
				facts.wiring.map((entry) => (
					<tr>
						<td>
							<code>{entry.unit}-police</code>
						</td>
						<td>{entry.event}</td>
						<td>
							<code>{entry.matcher}</code>
						</td>
						<td>{entry.timeout}s</td>
						<td>{entry.failClosedBudget === null ? "—" : `${entry.failClosedBudget}s`}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.ak-table {
		overflow-x: auto;
	}
	td code {
		white-space: nowrap;
	}
</style>
