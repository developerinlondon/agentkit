---
import current from "../generated/kit-facts.json";
import { factsFor, frozenByVersion } from "../lib/version-facts";

const frozen = frozenByVersion(
	import.meta.glob("../generated/frozen-facts/*.json", { eager: true }),
);
const { facts } = factsFor(Astro.url.pathname, current, frozen);
---

<div class="ak-table">
	<table>
		<thead>
			<tr>
				<th>Group</th>
				<th>Skills</th>
				<th>Selection</th>
				<th>What it covers</th>
			</tr>
		</thead>
		<tbody>
			{
				facts.groups.map((group) => (
					<tr>
						<td>
							<code>{group.id}</code>
						</td>
						<td>{facts.skills.filter((skill) => skill.group === group.id).length}</td>
						<td>
							{
								group.id === "core"
									? "always installed"
									: group.explicit
									? "explicit opt-in only"
									: "offered by default"
							}
						</td>
						<td>{group.description}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.ak-table {
		overflow-x: auto;
	}
	td code {
		white-space: nowrap;
	}
</style>
