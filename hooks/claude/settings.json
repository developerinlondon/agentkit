{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-police.sh",
            "timeout": 10,
            "statusMessage": "git-police: checking safety rules..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/kubectl-police.sh",
            "timeout": 10,
            "statusMessage": "kubectl-police: checking Kargo safety..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pkg-police.sh",
            "timeout": 10,
            "statusMessage": "pkg-police: checking the project's package manager..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pages-police.sh",
            "timeout": 10,
            "statusMessage": "pages-police: guarding page publishes..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/resource-police.sh",
            "timeout": 10,
            "statusMessage": "resource-police: requiring bounded execution..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/mr-police.sh",
            "timeout": 15,
            "statusMessage": "mr-police: checking for unmerged MRs..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/fail-closed-hook.sh 45 $HOME/.claude/hooks/review-police.sh",
            "timeout": 60,
            "statusMessage": "review-police: verifying the review gate..."
          }
        ]
      },
      {
        "matcher": ".*[Mm]erge.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/fail-closed-hook.sh 45 $HOME/.claude/hooks/review-police.sh",
            "timeout": 60,
            "statusMessage": "review-police: gating non-Bash merge tools..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-police.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/coding-police.sh",
            "timeout": 15,
            "statusMessage": "coding-police: checking coding standards..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/comment-police.sh",
            "timeout": 15,
            "statusMessage": "comment-police: checking comment discipline..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/chime.sh attention",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/chime.sh done",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/update-notice.sh",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
