#!/bin/bash -p
# agentkit:platforms linux
# Requires systemd user scopes and cgroup v2.
set -euo pipefail

readonly EX_USAGE=64
readonly EX_UNAVAILABLE=69
readonly SLICE=agent-work.slice
readonly LOCK_NAME=agentkit-run.lock
readonly PROC_ROOT=/proc
readonly USER_RUNTIME_ROOT=/run/user
readonly CGROUP_CONTROLLERS=/sys/fs/cgroup/cgroup.controllers
readonly GUARD_CONF=/etc/agentkit/resource-guard.conf
readonly VERIFY_CONTROL_OWNERSHIP=1
readonly MAX_ENV_UNWRAP=4
readonly AWK_BIN=/usr/bin/awk
readonly ENV_BIN=/usr/bin/env
readonly FLOCK_BIN=/usr/bin/flock
readonly GETCONF_BIN=/usr/bin/getconf
readonly ID_BIN=/usr/bin/id
readonly REALPATH_BIN=/usr/bin/realpath
readonly STAT_BIN=/usr/bin/stat
readonly SYSTEMCTL_BIN=/usr/bin/systemctl
readonly SYSTEMD_RUN_BIN=/usr/bin/systemd-run
readonly TIMEOUT_BIN=/usr/bin/timeout

usage() {
	cat <<'USAGE'
Usage: bounded-run [--profile canary|default|compile|browser] -- COMMAND [ARG...]

Run one resource-intensive command in a bounded systemd user service. The command
is passed as argv without shell evaluation. Only one bounded-run may run at once.
USAGE
}

die() {
	local message="$1"
	local status="${2:-$EX_UNAVAILABLE}"
	printf 'bounded-run: %s\n' "$message" >&2
	exit "$status"
}

select_profile() {
	local profile="$1"
	case "$profile" in
	canary)
		MEMORY_HIGH=1G
		MEMORY_MAX=2G
		MEMORY_MAX_KIB=$((2 * 1024 * 1024))
		CPU_QUOTA=200%
		TASKS_MAX=64
		COMMAND_TIMEOUT=60s
		RUNTIME_MAX=75s
		;;
	default)
		MEMORY_HIGH=6G
		MEMORY_MAX=8G
		MEMORY_MAX_KIB=$((8 * 1024 * 1024))
		CPU_QUOTA=200%
		TASKS_MAX=256
		COMMAND_TIMEOUT=10m
		RUNTIME_MAX=10m15s
		;;
	compile)
		MEMORY_HIGH=8G
		MEMORY_MAX=12G
		MEMORY_MAX_KIB=$((12 * 1024 * 1024))
		CPU_QUOTA=400%
		TASKS_MAX=512
		COMMAND_TIMEOUT=15m
		RUNTIME_MAX=15m15s
		;;
	browser)
		MEMORY_HIGH=12G
		MEMORY_MAX=16G
		MEMORY_MAX_KIB=$((16 * 1024 * 1024))
		CPU_QUOTA=400%
		TASKS_MAX=1024
		COMMAND_TIMEOUT=20m
		RUNTIME_MAX=20m15s
		;;
	*) die "unknown profile '$profile'" "$EX_USAGE" ;;
	esac
}

parse_args() {
	PROFILE=default
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--profile)
			[[ $# -ge 2 ]] || die '--profile requires a value' "$EX_USAGE"
			PROFILE="$2"
			shift 2
			;;
		--help | -h)
			usage
			exit 0
			;;
		--)
			shift
			COMMAND=("$@")
			break
			;;
		*) die "unknown option '$1'; command must follow --" "$EX_USAGE" ;;
		esac
	done
	[[ ${#COMMAND[@]} -gt 0 ]] || die 'expected a command after --' "$EX_USAGE"
	select_profile "$PROFILE"
}

verify_root_owned_file() {
	local path="$1"
	[[ "$VERIFY_CONTROL_OWNERSHIP" == 1 ]] || return 0
	local owner mode
	read -r owner mode < <("$STAT_BIN" -Lc '%u %a' -- "$path") \
		|| die "could not inspect '$path'"
	[[ "$owner" == 0 ]] || die "'$path' is not root-owned"
	(( (8#$mode & 8#22) == 0 )) \
		|| die "'$path' is group- or world-writable"
}

verify_control_binary() {
	local path="$1"
	[[ -x "$path" ]] || die "required control binary '$path' is unavailable"
	verify_root_owned_file "$path"
}

verify_control_plane() {
	local path
	for path in \
		"$AWK_BIN" "$ENV_BIN" "$FLOCK_BIN" "$GETCONF_BIN" "$ID_BIN" \
		"$REALPATH_BIN" "$STAT_BIN" "$SYSTEMCTL_BIN" "$SYSTEMD_RUN_BIN" "$TIMEOUT_BIN"; do
		verify_control_binary "$path"
	done
	[[ -r "$CGROUP_CONTROLLERS" ]] || die 'cgroup v2 is unavailable'
}

prepare_user_bus() {
	local uid
	uid="$("$ID_BIN" -u)"
	CONTROL_RUNTIME_DIR="$USER_RUNTIME_ROOT/$uid"
	CONTROL_BUS_ADDRESS="unix:path=$CONTROL_RUNTIME_DIR/bus"
	[[ -e "$CONTROL_RUNTIME_DIR/bus" ]] \
		|| die "user systemd manager bus is unavailable at $CONTROL_RUNTIME_DIR/bus"
	export XDG_RUNTIME_DIR="$CONTROL_RUNTIME_DIR"
	export DBUS_SESSION_BUS_ADDRESS="$CONTROL_BUS_ADDRESS"
	"$SYSTEMCTL_BIN" --user show-environment >/dev/null 2>&1 \
		|| die 'user systemd manager is unavailable'
}

property_value() {
	local properties="$1"
	local name="$2"
	local key value
	while IFS='=' read -r key value; do
		if [[ "$key" == "$name" ]]; then
			printf '%s\n' "$value"
			return 0
		fi
	done <<<"$properties"
}

to_bytes() {
	local value="$1" number unit
	[[ "$value" =~ ^([0-9]+)([KMGT]?)$ ]] || return 1
	number="${BASH_REMATCH[1]}"
	unit="${BASH_REMATCH[2]}"
	case "$unit" in
	'') printf '%s\n' "$number" ;;
	K) printf '%s\n' $((number * 1024)) ;;
	M) printf '%s\n' $((number * 1024 * 1024)) ;;
	G) printf '%s\n' $((number * 1024 * 1024 * 1024)) ;;
	T) printf '%s\n' $((number * 1024 * 1024 * 1024 * 1024)) ;;
	esac
}

load_guard_expectations() {
	EXPECTED_MEMORY_HIGH=21474836480
	EXPECTED_MEMORY_MAX=25769803776
	EXPECTED_MEMORY_SWAP_MAX=0
	EXPECTED_CPU_QUOTA=8s
	EXPECTED_TASKS_MAX=1536
	[[ -f "$GUARD_CONF" ]] || return 0
	verify_root_owned_file "$GUARD_CONF"
	local line key value
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" || "$line" == \#* ]] && continue
		[[ "$line" == *=* ]] || die "malformed line in $GUARD_CONF: $line"
		key="${line%%=*}"
		value="${line#*=}"
		case "$key" in
		MEMORY_HIGH)
			EXPECTED_MEMORY_HIGH="$(to_bytes "$value")" \
				|| die "invalid MEMORY_HIGH '$value' in $GUARD_CONF"
			;;
		MEMORY_MAX)
			EXPECTED_MEMORY_MAX="$(to_bytes "$value")" \
				|| die "invalid MEMORY_MAX '$value' in $GUARD_CONF"
			;;
		MEMORY_SWAP_MAX)
			EXPECTED_MEMORY_SWAP_MAX="$(to_bytes "$value")" \
				|| die "invalid MEMORY_SWAP_MAX '$value' in $GUARD_CONF"
			;;
		CPU_QUOTA)
			[[ "$value" =~ ^[0-9]+00%$ ]] \
				|| die "CPU_QUOTA in $GUARD_CONF must be a multiple of 100% (found '$value')"
			EXPECTED_CPU_QUOTA="$((${value%\%} / 100))s"
			;;
		TASKS_MAX)
			[[ "$value" =~ ^[0-9]+$ ]] \
				|| die "invalid TASKS_MAX '$value' in $GUARD_CONF"
			EXPECTED_TASKS_MAX="$value"
			;;
		*) die "unknown key '$key' in $GUARD_CONF" ;;
		esac
	done <"$GUARD_CONF"
}

verify_aggregate_slice() {
	local properties load_state memory_high memory_max memory_swap_max cpu_quota tasks_max
	properties="$("$SYSTEMCTL_BIN" --user show "$SLICE" \
		--property=LoadState,MemoryHigh,MemoryMax,MemorySwapMax,CPUQuotaPerSecUSec,TasksMax \
		2>/dev/null)" || die "$SLICE is not installed"
	load_state="$(property_value "$properties" LoadState)"
	memory_high="$(property_value "$properties" MemoryHigh)"
	memory_max="$(property_value "$properties" MemoryMax)"
	memory_swap_max="$(property_value "$properties" MemorySwapMax)"
	cpu_quota="$(property_value "$properties" CPUQuotaPerSecUSec)"
	tasks_max="$(property_value "$properties" TasksMax)"

	[[ "$load_state" == loaded ]] || die "$SLICE is not loaded"
	[[ "$memory_high" == "$EXPECTED_MEMORY_HIGH" ]] \
		|| die "$SLICE MemoryHigh must be $EXPECTED_MEMORY_HIGH bytes (found ${memory_high:-unset})"
	[[ "$memory_max" == "$EXPECTED_MEMORY_MAX" ]] \
		|| die "$SLICE MemoryMax must be $EXPECTED_MEMORY_MAX bytes (found ${memory_max:-unset})"
	[[ "$memory_swap_max" == "$EXPECTED_MEMORY_SWAP_MAX" ]] \
		|| die "$SLICE MemorySwapMax must be $EXPECTED_MEMORY_SWAP_MAX bytes (found ${memory_swap_max:-unset})"
	[[ "$cpu_quota" == "$EXPECTED_CPU_QUOTA" ]] \
		|| die "$SLICE CPUQuota must be $EXPECTED_CPU_QUOTA of CPU per second (found ${cpu_quota:-unset})"
	[[ "$tasks_max" == "$EXPECTED_TASKS_MAX" ]] \
		|| die "$SLICE TasksMax must be $EXPECTED_TASKS_MAX (found ${tasks_max:-unset})"
}

verify_host_headroom() {
	local available_kib total_kib required_kib load_one cpu_count max_load pressure_some pressure_full
	[[ -r "$PROC_ROOT/meminfo" && -r "$PROC_ROOT/loadavg" \
		&& -r "$PROC_ROOT/pressure/memory" ]] \
		|| die 'host memory, load, or pressure metrics are unavailable'
	available_kib="$("$AWK_BIN" '/^MemAvailable:/ {print $2; exit}' "$PROC_ROOT/meminfo")"
	total_kib="$("$AWK_BIN" '/^MemTotal:/ {print $2; exit}' "$PROC_ROOT/meminfo")"
	[[ "$available_kib" =~ ^[0-9]+$ && "$total_kib" =~ ^[0-9]+$ ]] \
		|| die 'host total or available memory could not be read'
	required_kib=$((MEMORY_MAX_KIB + total_kib / 4))
	if ((available_kib < required_kib)); then
		die "insufficient memory for $PROFILE profile plus 25% host reserve"
	fi

	read -r load_one _ <"$PROC_ROOT/loadavg"
	cpu_count="$("$GETCONF_BIN" _NPROCESSORS_ONLN)"
	max_load=$((cpu_count * 2))
	"$AWK_BIN" -v current="$load_one" -v limit="$max_load" \
		'BEGIN { exit !(current <= limit) }' \
		|| die "one-minute load $load_one exceeds preflight limit $max_load"

	pressure_some="$("$AWK_BIN" '/^some / {sub(/^.*avg10=/, ""); sub(/ .*/, ""); print}' \
		"$PROC_ROOT/pressure/memory")"
	pressure_full="$("$AWK_BIN" '/^full / {sub(/^.*avg10=/, ""); sub(/ .*/, ""); print}' \
		"$PROC_ROOT/pressure/memory")"
	[[ -n "$pressure_some" && -n "$pressure_full" ]] || die 'host memory pressure could not be read'
	"$AWK_BIN" -v some="$pressure_some" -v full="$pressure_full" \
		'BEGIN { exit !(some <= 10 && full <= 2) }' \
		|| die "memory pressure is elevated (some=$pressure_some, full=$pressure_full)"
}

build_clean_environment() {
	CLEAN_ENV=("$ENV_BIN" -i)
	local name
	local -a allowed=(
		HOME USER LOGNAME PATH SHELL TERM COLORTERM LANG LANGUAGE LC_ALL TZ
		XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME
		BUN_INSTALL CARGO_HOME RUSTUP_HOME GOCACHE GOMODCACHE GOPATH
		GOMEMLIMIT GOMAXPROCS NODE_OPTIONS PLAYWRIGHT_BROWSERS_PATH
		CI NO_COLOR FORCE_COLOR SSH_AUTH_SOCK
	)
	for name in "${allowed[@]}"; do
		# `[[ -v VAR ]]` is bash 4.2+; macOS ships bash 3.2, where it is a
		# parse error ("conditional binary operator expected") that aborts the
		# runner. `${!name+x}` is the portable set-or-not test and, unlike
		# `-n "${!name}"`, still passes through variables set to empty.
		if [[ -n "${!name+x}" ]]; then
			CLEAN_ENV+=("$name=${!name}")
		fi
	done
	CLEAN_ENV+=(AGENTKIT_RUN_ACTIVE=1)
}

reject_command_basename() {
	local executable="$1"
	case "$executable" in
	agentkit-run | bounded-run) die 'nested bounded-run commands are not allowed' "$EX_USAGE" ;;
	doas | env | pkexec | run0 | su | sudo)
		die "$executable is not allowed inside bounded-run" "$EX_USAGE"
		;;
	ansible | ansible-playbook | buildah | docker | kubectl | machinectl | mosh | nerdctl | podman | service | ssh | systemctl | systemd-run)
		die "$executable delegates work outside the service cgroup" "$EX_USAGE"
		;;
	esac
}

resolve_path() {
	local candidate="$1" resolved
	if [[ "$candidate" == */* ]]; then
		resolved="$("$REALPATH_BIN" -e -- "$candidate" 2>/dev/null || true)"
	else
		resolved="$(type -P -- "$candidate" || true)"
		if [[ -n "$resolved" ]]; then
			resolved="$("$REALPATH_BIN" -e -- "$resolved" 2>/dev/null || true)"
		fi
	fi
	printf '%s' "$resolved"
}

# `env VAR=1 bun test` is the child that matters; classifying the literal `env`
# refused a benign command and, worse, would have read `env VAR=1 sudo x` as
# equally benign had the refusal been lifted without looking past the prefix.
unwrap_environment_prefix() {
	local depth=0
	CHILD_INDEX=0
	while [[ "${COMMAND[$CHILD_INDEX]##*/}" == env ]]; do
		depth=$((depth + 1))
		((depth <= MAX_ENV_UNWRAP)) \
			|| die "more than $MAX_ENV_UNWRAP env wrappers before the command" "$EX_USAGE"
		CHILD_INDEX=$((CHILD_INDEX + 1))
		# Allowlist, not blocklist: getopt_long accepts any unambiguous
		# abbreviation (--s= is --split-string), so only options that cannot
		# change what runs may be skipped.
		while [[ "${COMMAND[$CHILD_INDEX]:-}" == -* \
			|| "${COMMAND[$CHILD_INDEX]:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do
			if [[ "${COMMAND[$CHILD_INDEX]}" == -- ]]; then
				CHILD_INDEX=$((CHILD_INDEX + 1))
				break
			fi
			case "${COMMAND[$CHILD_INDEX]}" in
			--ignore-environment | --debug | --null) ;;
			-*)
				[[ "${COMMAND[$CHILD_INDEX]}" =~ ^-[iv0]+$ ]] \
					|| die "env option '${COMMAND[$CHILD_INDEX]}' is not allowed inside bounded-run; use -i/-v/-0, their long forms, --, or NAME=value" "$EX_USAGE"
				;;
			esac
			CHILD_INDEX=$((CHILD_INDEX + 1))
		done
		[[ -n "${COMMAND[$CHILD_INDEX]:-}" ]] || die 'expected a command after env' "$EX_USAGE"
	done
}

resolve_command() {
	local executable child
	unwrap_environment_prefix
	reject_command_basename "${COMMAND[$CHILD_INDEX]##*/}"
	executable="$(resolve_path "${COMMAND[0]}")"
	[[ -n "$executable" && -x "$executable" ]] \
		|| die "command '${COMMAND[0]}' is not an executable file" "$EX_USAGE"
	COMMAND[0]="$executable"
	if ((CHILD_INDEX == 0)); then
		reject_command_basename "${COMMAND[0]##*/}"
		return 0
	fi
	child="$(resolve_path "${COMMAND[$CHILD_INDEX]}")"
	[[ -n "$child" && -x "$child" ]] \
		|| die "command '${COMMAND[$CHILD_INDEX]}' is not an executable file" "$EX_USAGE"
	reject_command_basename "${child##*/}"
}

inspect_command_arguments() {
	local executable="${COMMAND[$CHILD_INDEX]##*/}"
	local argument
	case "$executable" in
	bash | dash | fish | sh | zsh)
		for argument in "${COMMAND[@]:$((CHILD_INDEX + 1))}"; do
			case "$argument" in
			--command | --command=*)
				die 'shell command strings are not allowed; pass direct argv' "$EX_USAGE"
				;;
			--*) ;;
			-*c*)
				die 'shell command strings are not allowed; pass direct argv' "$EX_USAGE"
				;;
			esac
		done
		;;
	esac
}

run_bounded() {
	local unit="bounded-run-${PROFILE}-$$"
	local lock_file="$CONTROL_RUNTIME_DIR/$LOCK_NAME"
	local status
	set +e
	"$SYSTEMD_RUN_BIN" \
		--user \
		--expand-environment=no \
		--service-type=exec \
		--unit="$unit" \
		--description="Agentkit bounded $PROFILE command" \
		--slice="$SLICE" \
		--working-directory="$PWD" \
		--property="MemoryHigh=$MEMORY_HIGH" \
		--property="MemoryMax=$MEMORY_MAX" \
		--property="CPUQuota=$CPU_QUOTA" \
		--property="TasksMax=$TASKS_MAX" \
		--property=MemorySwapMax=0 \
		--property="RuntimeMaxSec=$RUNTIME_MAX" \
		--property=TimeoutStopSec=10s \
		--property=KillMode=control-group \
		--property=OOMPolicy=kill \
		--property=NoNewPrivileges=yes \
		--property=RestrictSUIDSGID=yes \
		--property=SendSIGKILL=yes \
		--property=Nice=10 \
		--property=KeyringMode=private \
		--property=UMask=0077 \
		--wait --collect --pipe --quiet \
		-- "${CLEAN_ENV[@]}" \
		"$FLOCK_BIN" --verbose --nonblock --conflict-exit-code=75 "$lock_file" \
		"$TIMEOUT_BIN" --signal=TERM --kill-after=10s "$COMMAND_TIMEOUT" \
		"${COMMAND[@]}"
	status=$?
	set -e
	return "$status"
}

declare -a COMMAND=()
declare -a CLEAN_ENV=()
declare PROFILE MEMORY_HIGH MEMORY_MAX MEMORY_MAX_KIB CPU_QUOTA TASKS_MAX COMMAND_TIMEOUT RUNTIME_MAX
declare CONTROL_RUNTIME_DIR CONTROL_BUS_ADDRESS CHILD_INDEX=0
declare EXPECTED_MEMORY_HIGH EXPECTED_MEMORY_MAX EXPECTED_MEMORY_SWAP_MAX EXPECTED_CPU_QUOTA EXPECTED_TASKS_MAX

parse_args "$@"
if [[ "${AGENTKIT_RUN_ACTIVE:-0}" == 1 ]]; then
	die 'nested bounded-run commands are not allowed' "$EX_USAGE"
fi
verify_control_plane
resolve_command
inspect_command_arguments
prepare_user_bus
load_guard_expectations
verify_aggregate_slice
verify_host_headroom
build_clean_environment
run_bounded
