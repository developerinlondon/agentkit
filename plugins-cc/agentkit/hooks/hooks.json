{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/git-police.sh",
            "timeout": 20,
            "statusMessage": "git-police: checking safety rules..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/issue-police.sh",
            "timeout": 10,
            "statusMessage": "issue-police: checking issue disposition..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/kubectl-police.sh",
            "timeout": 10,
            "statusMessage": "kubectl-police: checking Kargo safety..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pkg-police.sh",
            "timeout": 10,
            "statusMessage": "pkg-police: checking the project's package manager..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pages-police.sh",
            "timeout": 10,
            "statusMessage": "pages-police: guarding page publishes..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/resource-police.sh",
            "timeout": 10,
            "statusMessage": "resource-police: requiring bounded execution..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mr-police.sh",
            "timeout": 15,
            "statusMessage": "mr-police: checking for unmerged MRs..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/taste-police.sh",
            "timeout": 15,
            "statusMessage": "taste-police: applying your blocking tastes..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/prose-police.sh",
            "timeout": 15,
            "statusMessage": "prose-police: checking inline forge text..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/plan-police.sh",
            "timeout": 15,
            "statusMessage": "plan-police: checking the plan's gaps..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/format-police.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/coding-police.sh",
            "timeout": 15,
            "statusMessage": "coding-police: checking coding standards..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/comment-police.sh",
            "timeout": 15,
            "statusMessage": "comment-police: checking comment discipline..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/prose-police.sh",
            "timeout": 15,
            "statusMessage": "prose-police: checking for AI writing tells..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/chime.sh attention",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/chime.sh done",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/update-notice.sh",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
