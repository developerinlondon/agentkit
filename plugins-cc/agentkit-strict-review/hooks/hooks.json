{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/fail-closed-hook.sh 45 ${CLAUDE_PLUGIN_ROOT}/hooks/review-police.sh",
            "timeout": 60,
            "statusMessage": "review-police: verifying the review gate..."
          }
        ]
      },
      {
        "matcher": ".*[Mm]erge.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/fail-closed-hook.sh 45 ${CLAUDE_PLUGIN_ROOT}/hooks/review-police.sh",
            "timeout": 60,
            "statusMessage": "review-police: gating non-Bash merge tools..."
          }
        ]
      }
    ]
  }
}
