{
  "schema_version": 1,
  "risk": {
    "default_tier": "standard",
    "zones": [
      {
        "id": "agent-enforcement",
        "tier": "critical",
        "path_regexes": [
          "^(hooks/.*|policies/.*|tools/review-(gate|profile)|install\\.sh|lib/(install-platform|skill-kits)\\.sh|skills/KITS|scripts/(product-command|sync-cc-plugin\\.sh|skill-kits\\.ts)|plugins/.*\\.ts|plugins-cc/agentkit/(\\.claude-plugin/plugin\\.json|hooks/.*)|plugins-cc/agentkit-adversarial-review/.*|\\.agentkit/(config\\.yaml|product\\.yaml|review-policy\\.json)|\\.claude-plugin/marketplace\\.json|config\\.example\\.yaml)$"
        ]
      },
      {
        "id": "ci-and-test-routing",
        "tier": "critical",
        "path_regexes": [
          "^(\\.github/workflows/.*|\\.moon/.*|\\.prototools|moon\\.yml|package\\.json|bun\\.lock|scripts/check-test-slices\\.ts|tests/test-slices\\.test\\.ts)$"
        ]
      },
      {
        "id": "review-governance",
        "tier": "critical",
        "path_regexes": [
          "^skills/(adversarial-review|autonomous-workflow|product-review|test-driven-development)/.*$",
          "^plugins-cc/agentkit/skills/(autonomous-workflow|test-driven-development)/.*$",
          "^plugins-cc/agentkit-product/skills/product-review/.*$",
          "^instructions/(coding-discipline|evidence-gated-review)\\.md$",
          "^docs/review-process\\.md$",
          "^tests/(agentkit-plugin|codex-review-hooks|hook-supervisor|install-claude-plugin|install-tools|review-gate|review-profile|review-disciplines)\\.test\\.ts$",
          "^tests/review-police/.*$",
          "^plugins-cc/agentkit-adversarial-review/skills/adversarial-review/.*$"
        ]
      }
    ]
  },
  "checks": {
    "affected-tests": {
      "command": "scripts/product-command default -- moon ci"
    },
    "tests": {
      "command": "scripts/product-command default -- bun test"
    }
  },
  "tiers": {
    "trivial": {
      "required_checks": [
        "affected-tests"
      ],
      "analyses": {
        "claims_audit": {
          "allow_not_applicable": false
        }
      },
      "allowed_product_coverage": [
        "none",
        "not_applicable",
        "partial",
        "complete"
      ],
      "require_verified_claims": false,
      "allow_unverified_claims": false,
      "allow_local_consent": true,
      "require_product_review": false,
      "require_evidence_ref": false
    },
    "standard": {
      "required_checks": [
        "affected-tests"
      ],
      "analyses": {
        "claims_audit": {
          "allow_not_applicable": false
        },
        "falsification": {
          "allow_not_applicable": false
        },
        "failure_trace": {
          "allow_not_applicable": true
        },
        "analogy_differences": {
          "allow_not_applicable": true
        },
        "pattern_sweep": {
          "allow_not_applicable": true
        },
        "new_assumptions": {
          "allow_not_applicable": false
        },
        "artifact_lifetime": {
          "allow_not_applicable": true
        }
      },
      "allowed_product_coverage": [
        "none",
        "not_applicable",
        "partial",
        "complete"
      ],
      "require_verified_claims": false,
      "allow_unverified_claims": false,
      "allow_local_consent": true,
      "require_product_review": false,
      "require_evidence_ref": true
    },
    "critical": {
      "required_checks": [
        "tests"
      ],
      "analyses": {
        "claims_audit": {
          "allow_not_applicable": false
        },
        "falsification": {
          "allow_not_applicable": false
        },
        "failure_trace": {
          "allow_not_applicable": true
        },
        "analogy_differences": {
          "allow_not_applicable": true
        },
        "pattern_sweep": {
          "allow_not_applicable": true
        },
        "new_assumptions": {
          "allow_not_applicable": false
        },
        "artifact_lifetime": {
          "allow_not_applicable": true
        }
      },
      "allowed_product_coverage": [
        "partial",
        "complete"
      ],
      "require_verified_claims": true,
      "allow_unverified_claims": false,
      "allow_local_consent": false,
      "require_product_review": true,
      "require_evidence_ref": true
    }
  }
}
